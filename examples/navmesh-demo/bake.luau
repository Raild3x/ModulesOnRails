--!strict
-- Bakes Level.luau into Baked.luau: a ModuleScript returning NavMesh.Serialize's buffer as a
-- string, so the Lune sim and the Studio place both load the mesh with Deserialize, the way a
-- shipped game would. Run: lune run examples/navmesh-demo/bake.luau
local fs = require("@lune/fs")
local NavMesh = require("../../lib/navmesh/src/NavMesh")
local Level = require("./Level")

local t0 = os.clock()
local mesh = NavMesh.Build(Level.Desc)
local buildMs = (os.clock() - t0) * 1000
t0 = os.clock()
local data = NavMesh.Serialize(mesh)
local serializeMs = (os.clock() - t0) * 1000

-- HAND-ROLLED: there is no documented way to ship a buffer in a place, so write it as a
-- string literal of \xNN escapes (a ModuleScript can only hold text).
local bytes = table.create(buffer.len(data))
for i = 0, buffer.len(data) - 1 do
	bytes[i + 1] = string.format("\\x%02x", buffer.readu8(data, i))
end
local lines = {}
for i = 1, #bytes, 48 do
	table.insert(lines, '\t"' .. table.concat(bytes, "", i, math.min(i + 47, #bytes)) .. '"')
end
local source = "-- Generated by bake.luau from Level.luau: NavMesh.Serialize output. Do not edit.\n"
	.. "return table.concat({\n"
	.. table.concat(lines, ",\n")
	.. ",\n})\n"
fs.writeFile("examples/navmesh-demo/Baked.luau", source)
print(
	string.format(
		"baked %d bytes (%d source chars): Build %.2f ms, Serialize %.2f ms",
		buffer.len(data),
		#source,
		buildMs,
		serializeMs
	)
)
